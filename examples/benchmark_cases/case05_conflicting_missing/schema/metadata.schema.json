{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qrest.local/schema/metadata.0.1.0.schema.json",
  "title": "qREST Engineering Metadata (V0.1)",
  "description": "Metadata contract for structural light-weight seismic monitoring projects. Groups: Project, Site, Structure, Instruments, Monitoring(Sensors/Channels). Missing or uncertain information must be omitted rather than guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "Project"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "0.1.0",
      "description": "Fixed qREST metadata schema version."
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Name"
      ],
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 1
        },
        "Code": {
          "type": "string",
          "minLength": 1,
          "description": "Optional project code given in source materials."
        },
        "Description": {
          "type": "string"
        }
      }
    },
    "Site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SiteClass": {
          "enum": [
            "I0",
            "I1",
            "II",
            "III",
            "IV"
          ],
          "description": "Chinese seismic site classification (GB 50011)."
        },
        "Address": {
          "type": "string"
        },
        "Latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "Longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "Description": {
          "type": "string"
        }
      }
    },
    "Structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "StructureType": {
          "enum": [
            "Frame",
            "ShearWall",
            "FrameShearWall",
            "FrameTube",
            "TubeInTube",
            "SteelFrame",
            "Other"
          ]
        },
        "Stories": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Total above-ground stories."
        },
        "BelowGroundStories": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "Height": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000,
          "description": "Building height in meters."
        },
        "IsolationSystem": {
          "type": "boolean"
        },
        "IsolationType": {
          "enum": [
            "LeadRubberBearing",
            "RubberBearing",
            "FrictionPendulum",
            "Other"
          ],
          "description": "Isolation device family; use only when IsolationSystem=true."
        },
        "SeismicDesignIntensity": {
          "type": "integer",
          "minimum": 6,
          "maximum": 9,
          "description": "Chinese seismic fortification intensity."
        },
        "Description": {
          "type": "string"
        }
      }
    },
    "Instruments": {
      "type": "array",
      "description": "Data acquisition instruments available on site.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "InstrumentID"
        ],
        "properties": {
          "InstrumentID": {
            "type": "string",
            "minLength": 1
          },
          "InstrumentType": {
            "enum": [
              "Accelerometer",
              "Seismometer",
              "DataAcquisitionSystem",
              "Recorder",
              "Other"
            ]
          },
          "Model": {
            "type": "string"
          },
          "SerialNumber": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          }
        }
      }
    },
    "Monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Sensors": {
          "type": "array",
          "description": "Physical sensors attached to instruments.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "SensorID",
              "InstrumentID"
            ],
            "properties": {
              "SensorID": {
                "type": "string",
                "minLength": 1
              },
              "InstrumentID": {
                "type": "string",
                "minLength": 1,
                "description": "Must reference an existing Instruments[].InstrumentID."
              },
              "SensorType": {
                "enum": [
                  "Accelerometer",
                  "Seismometer",
                  "Tiltmeter",
                  "StrainGauge",
                  "Other"
                ]
              },
              "Floor": {
                "type": "string",
                "description": "Installation floor as written in source, e.g. 1F / RooF."
              },
              "Direction": {
                "enum": [
                  "X",
                  "Y",
                  "Z",
                  "XY",
                  "XZ",
                  "YZ",
                  "Triaxial"
                ]
              },
              "LocationDescription": {
                "type": "string"
              }
            }
          }
        },
        "Channels": {
          "type": "array",
          "description": "Measurement channels of the monitoring system.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ChannelID",
              "SensorID"
            ],
            "properties": {
              "ChannelID": {
                "type": "string",
                "minLength": 1
              },
              "SensorID": {
                "type": "string",
                "minLength": 1,
                "description": "Must reference an existing Monitoring.Sensors[].SensorID."
              },
              "ChannelNumber": {
                "type": "integer",
                "minimum": 1
              },
              "PhysicalQuantity": {
                "enum": [
                  "Acceleration",
                  "Velocity",
                  "Displacement",
                  "Strain",
                  "Tilt",
                  "Other"
                ]
              },
              "SamplingRateHz": {
                "type": "number",
                "minimum": 0
              },
              "Description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
